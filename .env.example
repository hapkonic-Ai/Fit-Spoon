# ─── BACKEND (copy to backend/.env) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/chefmate?sslmode=require
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_EXPIRES_IN=7d
ANTHROPIC_API_KEY=sk-ant-api03-...
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_AI_CHAT=20
RATE_LIMIT_AI_GENERATE=10
RATE_LIMIT_GENERAL=100
RATE_LIMIT_WINDOW_MS=60000

# ─── FRONTEND (copy to frontend/.env.local) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=ChefMate AI
NEXT_PUBLIC_APP_VERSION=1.0.0
